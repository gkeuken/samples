//*
//*-----------------------------------------------------------------*
//*  Step 1: Compile the C put program                              *
//*-----------------------------------------------------------------*
//COMPILE  EXEC PGM=CCNDRVR,REGION=0M,
//         PARM='OPTFILE(DD:OPTIONS)'
//STEPLIB  DD DSN={{ chlq }}.SCCNCMP,DISP=SHR
//SYSLIB DD DISP=SHR,DSN={{ mqhlq }}.SCSQLOAD
//       DD DISP=SHR,DSN={{ mqhlq }}.SCSQC370
//SYSIN    DD *
#include <string.h>
#include <cmqc.h>
int main(int argc, char *argv[])
{
    MQHCONN hConn = MQHC_UNUSABLE_HCONN;
    MQHOBJ  hObj  = MQHO_UNUSABLE_HOBJ;
    MQLONG  cc, rc;
    MQOD od  = {MQOD_DEFAULT};
    MQMD md  = {MQMD_DEFAULT};
    MQPMO pmo = {MQPMO_DEFAULT};
    char *qmgr = "{{ q_mgr }}";
    char *queue = "{{ q_name }}";
    char *msg   = "{{ q_message }}";
    MQLONG msgLen = (MQLONG)strlen(msg);
    MQCONN(qmgr, &hConn, &cc, &rc);
    if (cc != MQCC_OK) return 8;
    strncpy(od.ObjectName, queue, MQ_Q_NAME_LENGTH);
    MQOPEN(hConn, &od, MQOO_OUTPUT|MQOO_FAIL_IF_QUIESCING,
           &hObj, &cc, &rc);
    if (cc != MQCC_OK) { MQDISC(&hConn,&cc,&rc); return 8; }
    memcpy(md.Format, MQFMT_STRING, MQ_FORMAT_LENGTH);
    md.Persistence = MQPER_PERSISTENT;
    pmo.Options = MQPMO_NO_SYNCPOINT|MQPMO_FAIL_IF_QUIESCING;
    /* --- BEFORE MQPUT: ensure MQ generates a new MsgId --- */
    memcpy(md.MsgId, MQMI_NONE, sizeof(md.MsgId));
    memcpy(md.Format, MQFMT_STRING, MQ_FORMAT_LENGTH);
    md.Persistence = MQPER_PERSISTENT;
    pmo.Options = MQPMO_NO_SYNCPOINT | MQPMO_FAIL_IF_QUIESCING;
    MQPUT(hConn, hObj, &md, &pmo, msgLen, msg, &cc, &rc);
    /* --- AFTER MQPUT: print the MsgId as hex --- */
    if (cc == MQCC_OK) {
        int i;
        for (i = 0; i < MQ_MSG_ID_LENGTH; i++)
            printf("%02X", (unsigned char)md.MsgId[i]);
        printf("\n");
    } else {
        printf("Message put failure on queue '%s'\n", queue);
        MQCLOSE(hConn, &hObj, MQCO_NONE, &cc, &rc);
        MQDISC(&hConn, &cc, &rc);
        return 8;
    }
    MQCLOSE(hConn, &hObj, MQCO_NONE, &cc, &rc);
    MQDISC(&hConn, &cc, &rc);
    return (cc == MQCC_OK) ? 0 : 8;
}
